rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'havenclothingindia@gmail.com' ||
        request.auth.token.email == 'garvitsharma2212@gmail.com' ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // Categories catalog
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // Customer Orders
    match /orders/{orderId} {
      // Allow single document get (for customer tracking & order confirmation)
      allow get: if true;
      
      // Allow list queries strictly to authorized admins to protect customer PII
      allow list: if isAuthorizedAdmin();

      // Customers can create valid COD orders
      allow create: if (
        incoming().orderNumber is string &&
        incoming().customerName is string && incoming().customerName.size() > 0 && incoming().customerName.size() <= 150 &&
        incoming().phone is string && incoming().phone.size() >= 7 && incoming().phone.size() <= 20 &&
        incoming().address is string && incoming().address.size() > 0 && incoming().address.size() <= 500 &&
        incoming().city is string && incoming().city.size() <= 100 &&
        incoming().state is string && incoming().state.size() <= 100 &&
        incoming().pincode is string && incoming().pincode.size() <= 10 &&
        incoming().items is list && incoming().items.size() > 0 &&
        incoming().totalAmount is number && incoming().totalAmount >= 0 &&
        incoming().paymentMethod == 'COD' &&
        incoming().paymentStatus == 'PENDING' &&
        incoming().orderStatus == 'NEW'
      );

      // Only administrators can update orders (e.g., status changes, tracking numbers)
      allow update: if isAuthorizedAdmin();

      // Only administrators can delete orders
      allow delete: if isAuthorizedAdmin();
    }

    // Admin Users Directory
    match /adminUsers/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedAdmin() || (isSignedIn() && request.auth.token.email == 'havenclothingindia@gmail.com');
    }

    // Store Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Test connection document
    match /test/connection {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
  }
}
